{
  "name": "orbital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:assets": "node scripts/check-asset-budget.mjs",
    "check:shaders": "node scripts/check-shader-ramps.mjs",
    "build:iss-lod": "node scripts/build-iss-locate-lod.mjs",
    "build:earth-8k": "node scripts/build-earth-8k.mjs",
    "build:sky": "node scripts/build-sky.mjs",
    "build:places": "node scripts/build-place-index.mjs",
    "build:cities": "node scripts/build-city-index.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "patch:basis": "node scripts/patch-basis-transcoder.mjs",
    "preview": "vite preview",
    "bench": "node scripts/bench/bench.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "refresh:tle": "node scripts/refresh-fallback-tle.mjs",
    "test": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run check:assets && npm run check:shaders && npm run typecheck && npm run lint && npm test -- --run && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "camera-controls": "^3.1.2",
    "h5wasm": "^0.10.3",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "^5.0.0",
    "sharp": "^0.35.5",
    "three": "^0.170.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "draco3dgltf": "^1.5.9",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fbx2gltf": "^0.9.7-p1",
    "globals": "17.13.0",
    "meshoptimizer": "^1.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "^6.4.5",
    "vite-plugin-glsl": "^1.6.2",
    "vitest": "^5.0.5"
  }
}
