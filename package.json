{
  "name": "orbital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:assets": "node scripts/check-asset-budget.mjs",
    "check:shaders": "node scripts/check-shader-ramps.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "refresh:tle": "node scripts/refresh-fallback-tle.mjs",
    "test": "vitest",
    "verify": "npm run check:assets && npm run check:shaders && npm run typecheck && npm run lint && npm test -- --run && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^9.115.0",
    "@react-three/fiber": "^8.17.0",
    "camera-controls": "^2.9.0",
    "idb-keyval": "^6.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "satellite.js": "^5.0.0",
    "three": "^0.170.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "draco3dgltf": "^1.5.7",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fbx2gltf": "^0.9.7-p1",
    "globals": "17.13.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.71.0",
    "vite": "^6.0.0",
    "vite-plugin-glsl": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
